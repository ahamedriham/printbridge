    "build": "node -e \"require('./src/printbridge.js'); console.log('ok')\"",
    "test": "node test/escpos.test.js"
  },
  "keywords": [
    "print",
    "escpos",
    "receipt",
    "pos",
    "thermal-printer",
    "qz-tray",
    "websocket",
    "serial",
    "usb"
  ],
