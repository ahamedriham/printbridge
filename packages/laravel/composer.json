{
    "name": "ahamed/printbridge-laravel",
    "description": "Laravel integration for PrintBridge — silent ESC/POS, PDF and HTML printing from Blade/Vue apps via the open-source PrintBridge desktop bridge. QZ Tray alternative with no certificates.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "print", "escpos", "receipt", "pos", "thermal", "qz-tray", "printbridge"],
    "homepage": "https://github.com/ahamedriham/printbridge",
    "authors": [
        { "name": "Ahamed", "email": "ahamedriham@gmail.com" }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": { "PrintBridge\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "PrintBridge\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["PrintBridge\\Laravel\\PrintBridgeServiceProvider"],
            "aliases": { "PrintBridge": "PrintBridge\\Laravel\\Facades\\PrintBridge" }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
